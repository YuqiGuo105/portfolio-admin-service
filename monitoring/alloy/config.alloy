prometheus.exporter.blackbox "portfolio_voice_relay" {
  config = `modules:
  health:
    prober: http
    timeout: 8s
    http:
      valid_status_codes: [200]
      follow_redirects: false
      preferred_ip_protocol: ip4
      fail_if_body_not_matches_regexp: ["\"ok\"\\s*:\\s*true"]
`
  target {
    name = "portfolio-voice-relay"
    address = "https://portfolio-voice-relay-y45c2mnbja-uc.a.run.app/health"
    module = "health"
  }
}
prometheus.scrape "portfolio_voice_relay" {
  targets = prometheus.exporter.blackbox.portfolio_voice_relay.targets
  scrape_interval = "120s"
  scrape_timeout = "10s"
  forward_to = [prometheus.relabel.portfolio_voice_relay.receiver]
}
prometheus.relabel "portfolio_voice_relay" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  rule {
    source_labels = ["job"]
    regex = "integrations/blackbox/portfolio-voice-relay"
    target_label = "job"
    replacement = "portfolio-voice-relay"
  }
  rule {
    source_labels = ["__name__"]
    regex = "up|probe_success|probe_duration_seconds|probe_http_status_code"
    action = "keep"
  }
}

prometheus.exporter.blackbox "portfolio_mcp_server" {
  config = `modules:
  health:
    prober: http
    timeout: 8s
    http:
      valid_status_codes: [200]
      follow_redirects: false
      preferred_ip_protocol: ip4
      fail_if_body_not_matches_regexp: ["\"status\"\\s*:\\s*\"ok\"","\"server\"\\s*:\\s*\"yuqi-portfolio-mcp\""]
`
  target {
    name = "portfolio-mcp-server"
    address = "https://portfolio-mcp-server-y45c2mnbja-uc.a.run.app/health"
    module = "health"
  }
}
prometheus.scrape "portfolio_mcp_server" {
  targets = prometheus.exporter.blackbox.portfolio_mcp_server.targets
  scrape_interval = "120s"
  scrape_timeout = "10s"
  forward_to = [prometheus.relabel.portfolio_mcp_server.receiver]
}
prometheus.relabel "portfolio_mcp_server" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  rule {
    source_labels = ["job"]
    regex = "integrations/blackbox/portfolio-mcp-server"
    target_label = "job"
    replacement = "portfolio-mcp-server"
  }
  rule {
    source_labels = ["__name__"]
    regex = "up|probe_success|probe_duration_seconds|probe_http_status_code"
    action = "keep"
  }
}

prometheus.exporter.self "registry" {}
prometheus.scrape "registry" {
  targets = prometheus.exporter.self.registry.targets
  scrape_interval = "120s"
  forward_to = [prometheus.relabel.registry.receiver]
}
prometheus.relabel "registry" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  rule {
    source_labels = ["__name__"]
    regex = "up"
    action = "keep"
  }
  rule {
    target_label = "__name__"
    replacement = "portfolio_monitoring_registry_info"
  }
  rule {
    target_label = "job"
    replacement = "portfolio-monitoring-registry"
  }
  rule {
    target_label = "instance"
    replacement = "collector"
  }
  rule {
    target_label = "revision"
    replacement = "ec87968af1c85cd5"
  }
}

