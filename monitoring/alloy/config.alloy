  targets = [{"__address__" = "portfolio-admin-service-702193211434.us-central1.run.app", "job" = "portfolio-admin-service"}]
  scheme = "https"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "60s"
  scrape_timeout = "15s"
  follow_redirects = false
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

